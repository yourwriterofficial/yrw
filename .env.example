# Copy to .env.local and fill in. Names only: never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin used in emails and printed payment links (no trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Daily job for developa stores (summaries, reminders, backups). Vercel sends it as a Bearer token.
# Leave empty and the job refuses to run.
CRON_SECRET=

# Image uploads through Google Drive (see scripts/google-apps-script-drive-uploader.gs)
GOOGLE_APPS_SCRIPT_UPLOAD_URL=
DRIVE_UPLOAD_SECRET=

# Optional: salt for anonymous visitor counts (defaults to a server secret)
ANALYTICS_SALT=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Developa site emails through a Google Apps Script mailer (scripts/google-apps-script-mailer.gs).
# Optional: without these, mail goes through the normal email service.
GOOGLE_APPS_SCRIPT_MAIL_URL=
MAIL_SECRET=
# Phone alerts for developa.me sites (web push). Generate a key pair with: npx web-push generate-vapid-keys
# The public key is NEXT_PUBLIC_VAPID_PUBLIC_KEY; the private key must stay secret.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
